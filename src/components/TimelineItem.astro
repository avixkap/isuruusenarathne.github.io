---
import { formatPeriod } from '../lib/content';

interface Props {
  title: string;
  subtitle: string;
  start: string;
  end?: string;
  tags?: string[];
}

const { title, subtitle, start, end, tags = [] } = Astro.props;
const isCurrent = !end;
---

<li class:list={['item', { current: isCurrent }]}>
  <span class="dot" aria-hidden="true"></span>
  <div class="item-head">
    <div>
      <h3 class="item-title">{title}</h3>
      <p class="item-subtitle">{subtitle}</p>
    </div>
    <span class="period">{formatPeriod(start, end)}</span>
  </div>
  <slot />
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</li>

<style>
  .item {
    position: relative;
    padding: 0 0 2rem 1.75rem;
    border-left: 2px solid var(--border);
  }

  .item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  .dot {
    position: absolute;
    top: 0.35rem;
    left: -7px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--text-muted);
    border-radius: 50%;
    background: var(--bg);
  }

  .current .dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .item-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .item-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .item-subtitle {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .period {
    align-self: flex-start;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .current .period {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .item :global(p:not(.item-subtitle)) {
    margin: 0.6rem 0 0.75rem;
    font-size: 0.93rem;
  }
</style>
